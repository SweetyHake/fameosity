<div class="fame-navigator">
  <div class="fame-nav-context">
    <div class="fame-context-slot fame-context-owner {{#unless ownerActor}}is-empty{{/unless}}" data-action="goToOwner">
      {{#if ownerActor}}
        <img class="fame-owner-img" src="{{ownerActor.img}}" alt="{{ownerActor.name}}">
        <div class="fame-context-texts">
          <span class="fame-context-label">{{localize (concat moduleId '.ui.context-character')}}</span>
          <span class="fame-context-name">{{ownerActor.name}}</span>
        </div>
        {{#unless ownerActor.isTracked}}
          <i class="fa-solid fa-plus fame-owner-track" data-tooltip="{{localize (concat moduleId '.tooltips.add-to-tracking')}}"></i>
        {{/unless}}
      {{else}}
        <div class="fame-owner-placeholder"><i class="fa-solid fa-user"></i></div>
        <div class="fame-context-texts">
          <span class="fame-context-label">{{localize (concat moduleId '.ui.context-character')}}</span>
          <span class="fame-context-name is-empty">{{localize (concat moduleId '.ui.no-character')}}</span>
        </div>
      {{/if}}
      <button type="button" class="fame-context-pick" data-action="openOwnerPicker" aria-label="{{localize (concat moduleId '.ui.pick-character')}}" data-tooltip="{{localize (concat moduleId '.ui.pick-character')}}">
        <i class="fa-solid fa-chevron-down"></i>
      </button>
    </div>

    <div class="fame-context-slot fame-context-party {{#if activePartyId}}{{else}}is-empty{{/if}}">
      {{#if activePartyId}}
        <div class="fame-context-main" data-action="selectEntity" data-entity-type="faction" data-entity-id="{{activePartyId}}">
          <i class="fa-solid fa-star fame-party-star"></i>
          <div class="fame-context-texts">
            <span class="fame-context-label">{{localize (concat moduleId '.ui.context-party')}}</span>
            <span class="fame-context-name">
              {{#if activePartyName}}{{activePartyName}}{{else}}{{localize (concat moduleId '.ui.active-characters')}}{{/if}}
            </span>
          </div>
        </div>
      {{else}}
        <i class="fa-solid fa-star fame-party-star is-muted"></i>
        <div class="fame-context-texts">
          <span class="fame-context-label">{{localize (concat moduleId '.ui.context-party')}}</span>
          <span class="fame-context-name is-empty">{{localize (concat moduleId '.ui.no-party')}}</span>
        </div>
        {{#if isGM}}
          <button type="button" class="fame-context-create" data-action="createActiveParty" data-tooltip="{{localize (concat moduleId '.ui.create-group')}}"><i class="fa-solid fa-plus"></i></button>
        {{/if}}
      {{/if}}
      {{#if isGM}}
        <button type="button" class="fame-context-pick" data-action="openPartyPicker" aria-label="{{localize (concat moduleId '.ui.pick-party')}}" data-tooltip="{{localize (concat moduleId '.ui.pick-party')}}">
          <i class="fa-solid fa-chevron-down"></i>
        </button>
      {{/if}}
    </div>
  </div>

  <div class="fame-nav-search">
    <div class="fame-nav-search-box">
      <i class="fa-solid fa-search"></i>
      <input type="text" class="fame-nav-search-input" placeholder="{{localize (concat moduleId '.picker.search')}}" value="{{navSearch}}">
    </div>
  </div>

  <div class="fame-nav-tree">
    <div class="fame-nav-group" data-group="locations">
      <div class="fame-nav-group-header" data-action="toggleNavGroup" data-group="locations">
        <i class="fa-solid fa-chevron-right"></i>
        <i class="fa-solid fa-map-marker-alt fame-nav-group-icon"></i>
        <span>{{localize (concat moduleId '.relations.tab-locations')}}</span>
        <span class="fame-nav-group-count">{{allLocations.length}}</span>
      </div>
      <div class="fame-nav-group-items">
        {{#each allLocations}}
        <div class="fame-nav-item {{#if (and (eq @root.selectedType 'location') (eq @root.selectedId id))}}selected{{/if}} {{#if hidden}}is-hidden{{/if}}" style="{{indentStyle level}}" data-action="selectEntity" data-entity-type="location" data-entity-id="{{id}}">
          {{#if hasChildren}}<span class="fame-nav-tree-toggle" data-action="toggleTreeExpand" data-id="{{id}}" data-type="location"><i class="fa-solid fa-{{#if childrenVisible}}minus{{else}}plus{{/if}}-square"></i></span>
          {{else}}<span class="fame-nav-item-indent"></span>{{/if}}
          <img class="fame-nav-item-img" src="{{image}}">
          <span class="fame-nav-item-name">{{name}}</span>
          <div class="fame-nav-item-badges">
            {{#if hidden}}<i class="fa-solid fa-eye-slash fame-nav-badge hidden"></i>{{/if}}
          </div>
        </div>
        {{/each}}
      </div>
    </div>

    <div class="fame-nav-group" data-group="factions">
      <div class="fame-nav-group-header" data-action="toggleNavGroup" data-group="factions">
        <i class="fa-solid fa-chevron-right"></i>
        <i class="fa-solid fa-flag fame-nav-group-icon"></i>
        <span>{{localize (concat moduleId '.relations.tab-factions')}}</span>
        <span class="fame-nav-group-count">{{allFactions.length}}</span>
      </div>
      <div class="fame-nav-group-items">
        {{#each allFactions}}
        <div class="fame-nav-item {{#if (and (eq @root.selectedType 'faction') (eq @root.selectedId id))}}selected{{/if}} {{#if hidden}}is-hidden{{/if}}" style="{{indentStyle level}}" data-action="selectEntity" data-entity-type="faction" data-entity-id="{{id}}">
          {{#if hasChildren}}<span class="fame-nav-tree-toggle" data-action="toggleTreeExpand" data-id="{{id}}" data-type="faction"><i class="fa-solid fa-{{#if childrenVisible}}minus{{else}}plus{{/if}}-square"></i></span>
          {{else}}<span class="fame-nav-item-indent"></span>{{/if}}
          <img class="fame-nav-item-img" src="{{image}}">
          <span class="fame-nav-item-name">{{name}}</span>
          <div class="fame-nav-item-badges">
            {{#if isPartyActive}}<i class="fa-solid fa-star fame-nav-item-star"></i>
            {{else}}<span class="fame-nav-item-tier" style="background:{{tier.color}}"></span>{{/if}}
            {{#if hidden}}<i class="fa-solid fa-eye-slash fame-nav-badge hidden"></i>{{/if}}
          </div>
        </div>
        {{/each}}
      </div>
    </div>

    {{#if playerActors.length}}
    <div class="fame-nav-group" data-group="pcs">
      <div class="fame-nav-group-header" data-action="toggleNavGroup" data-group="pcs">
        <i class="fa-solid fa-chevron-right"></i>
        <i class="fa-solid fa-star fame-nav-group-icon"></i>
        <span>{{#if activePartyName}}{{activePartyName}}{{else}}{{localize (concat moduleId '.ui.active-characters')}}{{/if}}</span>
      </div>
      <div class="fame-nav-group-items">
        {{#each playerActors}}
        <div class="fame-nav-item {{#if (and (eq @root.selectedType 'actor') (eq @root.selectedId id))}}selected{{/if}} {{#if hidden}}is-hidden{{/if}}" data-action="selectEntity" data-entity-type="actor" data-entity-id="{{id}}">
          <span class="fame-nav-item-indent"></span>
          <img class="fame-nav-item-img" src="{{img}}">
          <span class="fame-nav-item-name">{{name}}</span>
          <div class="fame-nav-item-badges">
            <span class="fame-nav-item-tier" style="background:{{#if partyTier}}{{partyTier.color}}{{else}}{{tier.color}}{{/if}}"></span>
            {{#if hidden}}<i class="fa-solid fa-eye-slash fame-nav-badge hidden"></i>{{/if}}
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if npcActors.length}}
    <div class="fame-nav-group" data-group="npcs">
      <div class="fame-nav-group-header" data-action="toggleNavGroup" data-group="npcs">
        <i class="fa-solid fa-chevron-right"></i>
        <i class="fa-solid fa-user-tie fame-nav-group-icon"></i>
        <span>{{localize (concat moduleId '.ui.npcs')}}</span>
        <span class="fame-nav-group-count">{{npcActors.length}}</span>
      </div>
      <div class="fame-nav-group-items">
        {{#each npcActors}}
        <div class="fame-nav-item {{#if (and (eq @root.selectedType 'actor') (eq @root.selectedId id))}}selected{{/if}} {{#if hidden}}is-hidden{{/if}}" data-action="selectEntity" data-entity-type="actor" data-entity-id="{{id}}">
          <span class="fame-nav-item-indent"></span>
          <img class="fame-nav-item-img" src="{{img}}">
          <span class="fame-nav-item-name">{{name}}</span>
          <div class="fame-nav-item-badges">
            <span class="fame-nav-item-tier" style="background:{{#if partyTier}}{{partyTier.color}}{{else}}{{tier.color}}{{/if}}"></span>
            {{#if hidden}}<i class="fa-solid fa-eye-slash fame-nav-badge hidden"></i>{{/if}}
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}
  </div>

  {{#if isGM}}
  <div class="fame-nav-actions">
    <button type="button" class="fame-nav-action-btn" data-action="openLocationCreator" data-tooltip="{{localize (concat moduleId '.tooltips.create-location')}}"><i class="fa-solid fa-map-marker-alt"></i></button>
    <button type="button" class="fame-nav-action-btn" data-action="openFactionCreator" data-tooltip="{{localize (concat moduleId '.tooltips.create-faction')}}"><i class="fa-solid fa-flag"></i></button>
    <button type="button" class="fame-nav-action-btn" data-action="openActorCreator" data-tooltip="{{localize (concat moduleId '.tooltips.create-actor')}}"><i class="fa-solid fa-user-plus"></i></button>
    <button type="button" class="fame-nav-action-btn" data-action="openReputationSettings" data-tooltip="{{localize (concat moduleId '.settings.reputationSettings.name')}}"><i class="fa-solid fa-sliders"></i></button>
  </div>
  {{/if}}
</div>